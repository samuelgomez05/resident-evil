---
import Modal from "./ModalBase.astro";
import { Icon } from "astro-icon/components";
---

<Modal id="galleryModalDialog" titleId="titleGalleryModal">
  <div
    class="relative w-full bg-black overflow-hidden flex items-center justify-center min-h-75 max-h-[75vh] p-2 sm:p-4"
  >
    <img
      id="imgGalleryModal"
      class="max-w-full max-h-[70vh] w-auto h-auto object-contain block mx-auto transition-opacity duration-200"
      src=""
      alt=""
    />
  </div>

  <!-- Navigation Buttons Container (Outside modal box: below on Mobile, flanking sides on PC) -->
  <div slot="external" class="flex justify-between items-center w-full pt-4 sm:pt-0 pointer-events-auto">
    <button
      id="prevGalleryModal"
      class="flex items-center justify-center bg-black border border-line text-ink w-10 h-10 cursor-pointer leading-none hover:bg-blood-bright hover:border-blood-bright transition-colors sm:absolute sm:-left-14 sm:top-1/2 sm:-translate-y-1/2 shadow-lg z-30"
      type="button"
      aria-label="Imagen anterior"
    >
      <Icon name="tabler:arrow-narrow-left" size={20} />
    </button>
    <button
      id="nextGalleryModal"
      class="flex items-center justify-center bg-black border border-line text-ink w-10 h-10 cursor-pointer leading-none hover:bg-blood-bright hover:border-blood-bright transition-colors sm:absolute sm:-right-14 sm:top-1/2 sm:-translate-y-1/2 shadow-lg z-30"
      type="button"
      aria-label="Siguiente imagen"
    >
      <Icon name="tabler:arrow-narrow-right" size={20} />
    </button>
  </div>
</Modal>

<script>
  import imagesData from "../../data/images.json";

  const gallery = imagesData.gallery;
  const dialog = document.getElementById(
    "galleryModalDialog",
  ) as HTMLDialogElement | null;
  const imgElement = document.getElementById(
    "imgGalleryModal",
  ) as HTMLImageElement | null;
  const titleModal = document.getElementById("titleGalleryModal");
  const prevBtn = document.getElementById("prevGalleryModal");
  const nextBtn = document.getElementById("nextGalleryModal");
  const openButtons = document.querySelectorAll(".open-gallery-modal");

  let currentIndex = 0;

  function updateGalleryView(index: number) {
    if (!gallery || gallery.length === 0) return;

    currentIndex = (index + gallery.length) % gallery.length;
    const currentItem = gallery[currentIndex];

    if (imgElement) {
      imgElement.style.opacity = "0.5";
      imgElement.src = currentItem.src;
      imgElement.alt =
        currentItem.alt || `Imagen ${currentIndex + 1} de la galería`;
      setTimeout(() => {
        imgElement.style.opacity = "1";
      }, 50);
    }

    if (titleModal) {
      const formattedNum = String(currentIndex + 1).padStart(2, "0");
      const totalNum = String(gallery.length).padStart(2, "0");
      titleModal.textContent = `${formattedNum} / ${totalNum}`;
    }
  }

  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const rawIdx = btn.getAttribute("data-gallery-index");
      const idx = rawIdx ? parseInt(rawIdx, 10) : 0;

      updateGalleryView(isNaN(idx) ? 0 : idx);

      if (dialog && !dialog.open) {
        dialog.classList.remove("is-closing");
        dialog.showModal();
        document.body.style.overflow = "hidden";
      }
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      updateGalleryView(currentIndex - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      updateGalleryView(currentIndex + 1);
    });
  }

  window.addEventListener("keydown", (e) => {
    if (!dialog || !dialog.open) return;

    if (e.key === "ArrowLeft") {
      updateGalleryView(currentIndex - 1);
    } else if (e.key === "ArrowRight") {
      updateGalleryView(currentIndex + 1);
    }
  });
</script>
