---
import { Icon } from "astro-icon/components";
import videos from "../data/videos.json";
---

<section class="videos-pin relative h-[300vh]" id="videosPin">
  <div
    class="videos-sticky sticky top-0 min-h-screen w-full overflow-hidden bg-void flex flex-col justify-between py-40 pb-20 select-none gap-12"
  >
    <!-- Section Header -->
    <div class="px-6 sm:px-12 md:px-16 max-w-7xl mx-auto w-full flex-none">
      <h2
        class="font-display font-black text-[clamp(32px,5.5vw,64px)] tracking-tight uppercase text-ink leading-none"
      >
        Vídeos oficiales
      </h2>
    </div>

    <!-- Horizontal Track Container -->
    <div class="w-full overflow-hidden my-auto">
      <div
        id="videosTrack"
        class="flex gap-6 sm:gap-10 px-6 sm:px-12 md:px-16 items-center"
      >
        {
          videos.map((video) => (
            <div
              class="video-card group relative flex-none w-[84vw] sm:w-145 md:w-175 lg:w-205 aspect-video bg-panel border border-line hover:border-blood-bright transition-all duration-500 overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.9)] cursor-pointer open-modal"
              data-trailer-open={video.id}
              role="button"
              tabindex="0"
              aria-label={`Ver ${video.title}`}
            >
              <!-- Thumbnail Image -->
              <img
                src={`https://img.youtube.com/vi/${video.videoId}/maxresdefault.jpg`}
                alt={video.alt}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />

              <!-- Dark & Blood Gradients Overlay -->
              <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent group-hover:from-black/50 transition-opacity duration-300"></div>
              <div class="absolute inset-0 border-2 border-blood-bright/0 group-hover:border-blood-bright/70 transition-colors duration-300 pointer-events-none"></div>

              <!-- Top-Right Play Button (As before, icon only without text) -->
              <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-10">
                <button
                  type="button"
                  class="open-modal flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 bg-blood-bright/90 group-hover:bg-blood-hover text-ink border border-blood-bright transition-all duration-300 shadow-[0_0_20px_rgba(178,31,46,0.5)] group-hover:scale-110 cursor-pointer"
                  data-trailer-open={video.id}
                  aria-label={`Reproducir ${video.title}`}
                >
                  <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full border border-current flex items-center justify-center text-[9px] flex-none">
                    <Icon name="tabler:player-play-filled" size={14} />
                  </span>
                </button>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Scroll Progress Indicator -->
    <div class="px-6 sm:px-12 md:px-16 max-w-7xl mx-auto w-full flex-none pt-2">
      <div class="flex items-center justify-between gap-6 sm:gap-10">
        <!-- Thin Progress Bar Line -->
        <div class="flex-1 h-0.5 bg-line relative overflow-hidden">
          <div
            id="videosProgressBar"
            class="h-full bg-blood-bright w-0 shadow-[0_0_10px_#b21f2e]"
          ></div>
        </div>

        <!-- Index Counter (Hidden on mobile, visible on sm+) -->
        <div class="hidden sm:flex font-mono text-[11px] tracking-widest text-ink uppercase items-center gap-1 flex-none">
          <span id="videosCurrentIdx" class="text-blood-bright font-bold">01</span>
          <span class="text-paper/40">/</span>
          <span class="text-paper/70">03</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const videosPin = document.getElementById("videosPin");
  const videosTrack = document.getElementById("videosTrack");
  const videosProgressBar = document.getElementById("videosProgressBar");
  const videosCurrentIdx = document.getElementById("videosCurrentIdx");

  let targetX = 0;
  let currentX = 0;
  let isRunning = false;

  function updateTarget() {
    if (!videosPin || !videosTrack) return;

    const rect = videosPin.getBoundingClientRect();
    const totalScrollable = videosPin.offsetHeight - window.innerHeight;
    if (totalScrollable <= 0) return;

    const scrolled = -rect.top;
    const rawProgress = Math.min(Math.max(scrolled / totalScrollable, 0), 1);

    const trackWidth = videosTrack.scrollWidth;
    const viewportWidth = window.innerWidth;
    const maxTranslateX = Math.max(0, trackWidth - viewportWidth + 120);

    targetX = rawProgress * maxTranslateX;

    if (!isRunning) {
      isRunning = true;
      requestAnimationFrame(animate);
    }
  }

  function animate() {
    const diff = targetX - currentX;
    currentX += diff * 0.07;

    if (videosTrack) {
      videosTrack.style.transform = `translate3d(-${currentX.toFixed(2)}px, 0, 0)`;
    }

    if (videosPin) {
      const trackWidth = videosTrack ? videosTrack.scrollWidth : 1;
      const viewportWidth = window.innerWidth;
      const maxTranslateX = Math.max(1, trackWidth - viewportWidth + 120);
      const progressRatio = Math.min(Math.max(currentX / maxTranslateX, 0), 1);

      if (videosProgressBar) {
        videosProgressBar.style.width = `${(progressRatio * 100).toFixed(2)}%`;
      }

      if (videosCurrentIdx) {
        const totalVideos = 3;
        const currentNum = Math.min(Math.floor(progressRatio * totalVideos) + 1, totalVideos);
        videosCurrentIdx.textContent = `0${currentNum}`;
      }
    }

    if (Math.abs(diff) > 0.05) {
      requestAnimationFrame(animate);
    } else {
      currentX = targetX;
      if (videosTrack) {
        videosTrack.style.transform = `translate3d(-${currentX}px, 0, 0)`;
      }
      isRunning = false;
    }
  }

  window.addEventListener("scroll", updateTarget, { passive: true });
  window.addEventListener("resize", updateTarget);
  updateTarget();
</script>
