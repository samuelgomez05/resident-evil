---
import { Icon } from "astro-icon/components";

import BtnBuyTicket from "./BtnBuyTicket.astro";
import BtnOpenTrailerModal from "./BtnOpenTrailerModal.astro";

import bgHero from "../assets/background-hero.webp";
---

<section class="hero-pin relative h-[280vh]" id="heroPin">
  <div class="hero-sticky sticky top-0 h-screen w-full overflow-hidden bg-void">
    <div
      class="hero-layer video-layer absolute inset-0 w-full h-full opacity-0 transition-opacity duration-500 pointer-events-none select-none"
      aria-hidden="true"
    >
      <div
        class="yt-wrap absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none overflow-hidden select-none"
        id="ytWrap"
      >
        <iframe
          id="bgFrame"
          class="w-full h-full border-0 block pointer-events-none"
          src="https://www.youtube-nocookie.com/embed/SJPu1spHqfk?si=nfdqfKPP4dvP-CAQ&controls=1&autoplay=1&mute=1&loop=1&cc_load_policy=1&disablekb=1&end=100&fs=0&iv_load_policy=3&rel=0&playlist=SJPu1spHqfk&playsinline=1"
          title="Resident Evil - Tráiler Teaser"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share;"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          tabindex="-1"
        >
        </iframe>
      </div>
    </div>
    <div
      class="hero-layer image-layer absolute inset-0 w-full h-full"
      style={`background-image: url('${bgHero.src}');`}
    >
    </div>
    <div class="hero-scrim absolute inset-0 z-2"></div>

    <div
      class="hero-content relative z-3 h-full w-full flex flex-col items-center justify-center text-center px-6 pointer-events-none select-none"
    >
      <div
        class="date-stamp font-display font-black text-[clamp(64px,14vw,200px)] tracking-[0.01em] text-ink leading-[0.9]"
      >
        17.09.<em class="not-italic text-blood-bright">26</em>
      </div>
      <p
        class="hero-sub mt-4.5 text-[clamp(11px,1.4vw,13px)] tracking-[0.3em] text-paper uppercase"
      >
        Solo en cines
      </p>
      <div class="hero-actions mt-8.5 flex gap-3.5 flex-wrap justify-center">
        <BtnBuyTicket />
        <BtnOpenTrailerModal />
      </div>
    </div>

    <div
      class="hero-scrollcue absolute left-1/2 bottom-9 -translate-x-1/2 z-3 text-ink"
    >
      <Icon
        name="tabler:chevrons-down"
        size={24}
        class="animate-[bounce_1.6s_ease-in-out_infinite] motion-reduce:animate-none"
      />
    </div>
  </div>
</section>

<script>
  const ytWrap = document.getElementById("ytWrap");
  function sizeBgVideo() {
    if (!ytWrap) return;
    const w = window.innerWidth,
      h = window.innerHeight;
    const ratio = 16 / 9;
    const overscan = 1.35;
    let targetW: number, targetH: number;
    if (w / h > ratio) {
      targetW = w * overscan;
      targetH = targetW / ratio;
    } else {
      targetH = h * overscan;
      targetW = targetH * ratio;
    }
    ytWrap.style.width = Math.ceil(targetW) + "px";
    ytWrap.style.height = Math.ceil(targetH) + "px";
  }
  window.addEventListener("resize", sizeBgVideo);
  sizeBgVideo();

  // YouTube API: loop continuo sin pantalla final de recomendados / canal
  const videoLayer = document.querySelector(".hero-layer.video-layer");
  function markVideoReady() {
    if (videoLayer && !videoLayer.classList.contains("ready")) {
      videoLayer.classList.add("ready");
    }
  }

  let ytPlayer: any;
  function initBgPlayer() {
    if ((window as any).YT && (window as any).YT.Player) {
      ytPlayer = new (window as any).YT.Player("bgFrame", {
        events: {
          onReady: (e: any) => {
            e.target.mute();
            e.target.playVideo();
          },
          onStateChange: (e: any) => {
            if (e.data === (window as any).YT.PlayerState.PLAYING) {
              markVideoReady();
            }
            if (e.data === (window as any).YT.PlayerState.ENDED) {
              e.target.seekTo(0);
              e.target.playVideo();
            }
          },
        },
      });
    }
  }

  if ((window as any).YT && (window as any).YT.Player) {
    initBgPlayer();
  } else {
    (window as any).onYouTubeIframeAPIReady = initBgPlayer;
    const tag = document.createElement("script");
    tag.src = "https://www.youtube.com/iframe_api";
    const firstScript = document.getElementsByTagName("script")[0];
    if (firstScript && firstScript.parentNode) {
      firstScript.parentNode.insertBefore(tag, firstScript);
    } else {
      document.head.appendChild(tag);
    }
  }

  setTimeout(markVideoReady, 1200);

  setInterval(() => {
    if (
      ytPlayer &&
      typeof ytPlayer.getCurrentTime === "function" &&
      typeof ytPlayer.getDuration === "function"
    ) {
      const dur = ytPlayer.getDuration();
      const cur = ytPlayer.getCurrentTime();
      if (dur > 0 && cur >= dur - 0.5) {
        ytPlayer.seekTo(0);
        ytPlayer.playVideo();
      }
    }
  }, 200);

  // ---------- scroll: revelado de imagen + fecha + acciones en el hero ----------
  const heroPin = document.getElementById("heroPin");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let ticking = false;

  function update() {
    ticking = false;
    if (!heroPin) return;
    const rect = heroPin.getBoundingClientRect();
    const total = heroPin.offsetHeight - window.innerHeight;
    const scrolled = -rect.top;
    const rawP = total > 0 ? Math.min(Math.max(scrolled / total, 0), 1) : 0;

    const start = 0.15;
    const end = 0.65;
    let p = 0;
    if (rawP <= start) {
      p = 0;
    } else if (rawP >= end) {
      p = 1;
    } else {
      p = (rawP - start) / (end - start);
    }

    document.documentElement.style.setProperty(
      "--reveal",
      reduceMotion ? (p > 0.3 ? "1" : "0") : p.toFixed(3),
    );
    const heroContent = document.querySelector(".hero-content") as HTMLElement;
    if (heroContent) {
      if (p > 0) {
        heroContent.style.pointerEvents = "auto";
        heroContent.style.userSelect = "auto";
      } else {
        heroContent.style.pointerEvents = "none";
        heroContent.style.userSelect = "none";
      }
    }
  }

  function onScroll() {
    if (!ticking) {
      window.requestAnimationFrame(update);
      ticking = true;
    }
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  update();
</script>

<style>
  .hero-layer.video-layer:global(.ready) {
    opacity: calc(1 - var(--reveal));
  }

  .hero-layer.image-layer {
    opacity: var(--reveal);
    background-position: center 30%;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .hero-scrim {
    background: linear-gradient(
      180deg,
      rgba(6, 6, 5, 0.55) 0%,
      rgba(6, 6, 5, calc(0.12 + var(--reveal) * 0.33)) 38%,
      rgba(6, 6, 5, calc(0.3 + var(--reveal) * 0.58)) 100%
    );
  }

  .hero-content {
    opacity: var(--reveal);
    transform: translateY(calc((1 - var(--reveal)) * 24px));
  }

  .hero-scrollcue {
    opacity: calc((1 - var(--reveal)) * 0.92);
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }
</style>
