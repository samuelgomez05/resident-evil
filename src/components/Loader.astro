---
import logo from "../assets/resident_evil_2026.webp";
---

<div
  id="loader"
  class="fixed inset-0 z-300 bg-[#060605] flex flex-col items-center justify-center p-6 select-none transition-all duration-700 ease-out [&.done]:opacity-0 [&.done]:invisible [&.done]:pointer-events-none"
>
  <!-- Ambient background glow -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(178,31,46,0.18)_0%,rgba(6,6,5,0.96)_70%)] pointer-events-none"
  >
  </div>

  <!-- Background floating particles -->
  <div
    class="particles-container absolute inset-0 overflow-hidden pointer-events-none"
  >
    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>
    <div class="particle p4"></div>
    <div class="particle p5"></div>
    <div class="particle p6"></div>
    <div class="particle p7"></div>
    <div class="particle p8"></div>
    <div class="particle p9"></div>
    <div class="particle p10"></div>
  </div>

  <!-- Main Center Content -->
  <div
    class="relative flex flex-col items-center z-10 text-center max-w-sm w-full"
  >
    <!-- Logo -->
    <div class="mb-7 relative flex items-center justify-center">
      <div
        class="absolute inset-0 bg-blood-bright/15 blur-2xl rounded-full scale-125"
      >
      </div>
      <img
        src={logo.src}
        alt="Resident Evil Logo"
        class="relative z-10 w-56 sm:w-64 drop-shadow-[0_0_25px_rgba(178,31,46,0.5)] animate-[logoGlow_3s_ease-in-out_infinite]"
      />
    </div>

    <!-- Formal Minimal Progress Bar -->
    <div
      class="w-48 sm:w-56 h-1 bg-white/10 rounded-full overflow-hidden relative shadow-[0_0_10px_rgba(178,31,46,0.2)]"
    >
      <div
        id="loaderFill"
        class="h-full w-0 bg-blood-bright transition-[width] duration-150 ease-out shadow-[0_0_8px_#b21f2e]"
      >
      </div>
    </div>

    <!-- Minimal Formal Label -->
    <div
      class="mt-3.5 text-[11px] tracking-[0.24em] text-paper/50 uppercase font-mono"
      id="loaderLabel"
    >
      0%
    </div>
  </div>
</div>

<script>
  const fill = document.getElementById("loaderFill");
  const label = document.getElementById("loaderLabel");
  const loader = document.getElementById("loader");

  if (loader && fill && label) {
    document.body.style.overflow = "hidden";
    let pct = 0;
    const iv = setInterval(() => {
      pct += Math.random() * 18 + 8;
      if (pct >= 100) {
        pct = 100;
        clearInterval(iv);
      }
      fill.style.width = pct + "%";
      label.textContent = Math.floor(pct) + "%";
      if (pct === 100) {
        setTimeout(() => {
          loader.classList.add("done");
          document.body.style.overflow = "";
        }, 300);
      }
    }, 140);
  }
</script>

<style>
  @keyframes logoGlow {
    0%,
    100% {
      filter: drop-shadow(0 0 15px rgba(178, 31, 46, 0.4));
      transform: scale(1);
    }
    50% {
      filter: drop-shadow(0 0 28px rgba(178, 31, 46, 0.75));
      transform: scale(1.015);
    }
  }

  /* Floating particles */
  .particles-container .particle {
    position: absolute;
    bottom: -10px;
    border-radius: 50%;
    background: rgba(178, 31, 46, 0.65);
    box-shadow: 0 0 6px rgba(178, 31, 46, 0.8);
    animation: floatUp linear infinite;
  }

  .p1 {
    left: 12%;
    width: 3px;
    height: 3px;
    animation-duration: 7s;
    animation-delay: 0s;
  }
  .p2 {
    left: 26%;
    width: 2px;
    height: 2px;
    animation-duration: 9s;
    animation-delay: 1.2s;
    background: rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
  }
  .p3 {
    left: 38%;
    width: 4px;
    height: 4px;
    animation-duration: 7.5s;
    animation-delay: 0.4s;
  }
  .p4 {
    left: 52%;
    width: 2px;
    height: 2px;
    animation-duration: 10s;
    animation-delay: 2.1s;
  }
  .p5 {
    left: 67%;
    width: 3px;
    height: 3px;
    animation-duration: 6.8s;
    animation-delay: 0.8s;
  }
  .p6 {
    left: 82%;
    width: 2px;
    height: 2px;
    animation-duration: 8.2s;
    animation-delay: 2.7s;
    background: rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
  }
  .p7 {
    left: 20%;
    width: 3px;
    height: 3px;
    animation-duration: 8.8s;
    animation-delay: 3.2s;
  }
  .p8 {
    left: 45%;
    width: 2px;
    height: 2px;
    animation-duration: 7.2s;
    animation-delay: 1.5s;
  }
  .p9 {
    left: 60%;
    width: 3.5px;
    height: 3.5px;
    animation-duration: 9.2s;
    animation-delay: 0.6s;
  }
  .p10 {
    left: 75%;
    width: 2px;
    height: 2px;
    animation-duration: 7.8s;
    animation-delay: 3.8s;
  }

  @keyframes floatUp {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0;
    }
    20% {
      opacity: 0.75;
    }
    80% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(-105vh) translateX(30px);
      opacity: 0;
    }
  }
</style>
